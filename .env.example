# Copy to .env with mode 0600; replace each placeholder with a distinct random token.
# The CLI and broker read this file internally. Do not source it or expose it to agents.
AGENT_BROKER_TOKEN_ARC=replace-with-unique-arc-token
AGENT_BROKER_TOKEN_MCOMMUNITY=replace-with-unique-mcommunity-token
AGENT_BROKER_TOKEN_UMGPT=replace-with-unique-umgpt-token
AGENT_BROKER_TOKEN_EXPENSE_REPORTS=replace-with-unique-expense-token
