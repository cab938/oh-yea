{
  "name": "agent-broker",
  "version": "0.2.0",
  "description": "Human-supervised broker for token-gated web extraction",
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "bin": {
    "agent-broker": "bin/agent-broker.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/",
    "services/*/workflow.md",
    "services/*/authentication.example.yaml",
    "services/*/templates/*.yaml",
    "skills/",
    "assets/agent-broker-mascot.png",
    "assets/icons/*.png",
    "docs/",
    "test/",
    "test-support/",
    ".env.example",
    "AGENTS.md",
    "IDEAS.md"
  ],
  "scripts": {
    "start": "electron .",
    "preview": "node scripts/preview.mjs",
    "smoke": "node scripts/electron-smoke.mjs",
    "smoke:linux": "bash scripts/smoke-linux.sh",
    "add-service-token": "node scripts/add-service-token.mjs",
    "test": "node --test",
    "check": "node --check bin/agent-broker.mjs && node --check src/main.mjs && node --check src/renderer/renderer.mjs && node --test"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "electron": "^43.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT"
}
